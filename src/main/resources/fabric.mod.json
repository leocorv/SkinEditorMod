{
  "schemaVersion": 1,
  "id": "skineditor",
  "version": "${version}",
  "name": "Skin Editor",
  "description": "Early experimental Fabric prototype for editing and layering Minecraft player skins in-game.",
  "authors": [
    "Léo Corvaisier-Palluy"
  ],
  "contact": {
    "sources": "https://github.com/leocorv/SkinEditorMod"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.nerix.skineditor.client.SkinEditorModDataGenerator"
    ],
    "client": [
      "org.nerix.skineditor.client.SkinEditorModClient"
    ],
    "main": [
      "org.nerix.skineditor.SkinEditorMod"
    ]
  },
  "mixins": [
    "skineditor.mixins.json",
    {
      "config": "skineditor.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
